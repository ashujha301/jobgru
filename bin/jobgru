#!/usr/bin/env bash
# Jobgru CLI — global install wrapper
set -euo pipefail

JOBGRU_HOME="${JOBGRU_HOME:-$HOME/.jobgru}"
PY="${JOBGRU_HOME}/.venv/bin/python"
SCRIPTS="${JOBGRU_HOME}/scripts"

die() { echo "jobgru: $*" >&2; exit 1; }

[[ -d "$JOBGRU_HOME" ]] || die "Not installed. Run: curl -fsSL .../install.sh | bash"

cmd="${1:-}"
shift || true

case "$cmd" in
  check)
    exec "$PY" "$SCRIPTS/jobgru_check.py" "$@"
    ;;
  help|-h|--help)
    exec "$PY" "$SCRIPTS/jobgru_help.py" "$@"
    ;;
  setup)
    url="" name="" resume=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --url) url="$2"; shift 2 ;;
        --name) name="$2"; shift 2 ;;
        --resume-link) resume="$2"; shift 2 ;;
        *) die "Unknown option: $1" ;;
      esac
    done
    [[ -n "$url" ]] || die "Usage: jobgru setup --url SHEET_URL --name YOUR_NAME [--resume-link URL]"
    args=(set --url "$url")
    [[ -n "$name" ]] && args+=(--name "$name")
    [[ -n "$resume" ]] && args+=(--resume-link "$resume")
    (cd "$JOBGRU_HOME" && "$PY" "$SCRIPTS/sheet_config.py" "${args[@]}")
    if [[ -n "$name" || -n "$resume" ]]; then
      (cd "$JOBGRU_HOME" && "$PY" -c "
from setup_sheet_profile import apply_user_profile
from sheet_config import get_spreadsheet_id, get_tab, get_resume_link_default, get_your_name
from sheets_write import sheets_service
svc = sheets_service()
apply_user_profile(svc, get_spreadsheet_id(), get_tab(),
    resume_link=get_resume_link_default(), your_name=get_your_name())
print('OK: sheet profile updated (O2, Q2-Q7)')
" 2>/dev/null) || echo "NOTE: Sheet profile write skipped (run gcloud auth first)"
    fi
    exec "$PY" "$SCRIPTS/jobgru_check.py" "$@"
    ;;
  mcp)
    exec "$PY" "$SCRIPTS/jobgru_mcp.py" "$@"
    ;;
  filter|filters)
    exec "$PY" "$SCRIPTS/jobgru_filters.py" "$@"
    ;;
  prompts|prompt)
    exec "$PY" "$SCRIPTS/jobgru_prompts.py" "$@"
    ;;
  delete)
    rows=""
    dry_run=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --rows) rows="$2"; shift 2 ;;
        --dry-run) dry_run=1; shift ;;
        *) die "Unknown option: $1" ;;
      esac
    done
    [[ -n "$rows" ]] || die "Usage: jobgru delete --rows 42-44   (or 42,43,44 or 42,44-46)"
    args=(delete-rows --rows "$rows")
    [[ "$dry_run" -eq 1 ]] && args+=(--dry-run)
    (cd "$JOBGRU_HOME" && exec "$PY" "$SCRIPTS/sheets_write.py" "${args[@]}")
    ;;
  ats)
    rows=""
    dry_run=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --rows) rows="$2"; shift 2 ;;
        --dry-run) dry_run=1; shift ;;
        *) die "Unknown option: $1" ;;
      esac
    done
    [[ -n "$rows" ]] || die "Usage: jobgru ats --rows 42-44   (or 42,43,44 or 42,44-46)"
    args=(rescore --rows "$rows")
    [[ "$dry_run" -eq 1 ]] && args+=(--dry-run)
    exec "$PY" "$SCRIPTS/ats_score.py" "${args[@]}"
    ;;
  update)
    if [[ -d "$JOBGRU_HOME/.git" ]]; then
      git -C "$JOBGRU_HOME" pull --ff-only
    fi
    "$PY" -m pip install -q -r "$SCRIPTS/requirements.txt"
    for entry in "$HOME/.cursor|cursor" "$HOME/.claude|claude" "$HOME/.codex|codex"; do
      agent_home="${entry%%|*}"
      cli="${entry##*|}"
      if [[ -d "$agent_home" ]] || command -v "$cli" >/dev/null 2>&1; then
        mkdir -p "$agent_home/skills/jobgru"
        cp "$JOBGRU_HOME/skill-global/jobgru/SKILL.md" "$agent_home/skills/jobgru/SKILL.md"
        echo "==> Refreshed skill: $agent_home/skills/jobgru/SKILL.md"
      fi
    done
    echo "OK: Jobgru updated"
    ;;
  uninstall)
    rm -f "$HOME/.local/bin/jobgru"
    rm -rf "$HOME/.cursor/skills/jobgru" "$HOME/.claude/skills/jobgru" "$HOME/.codex/skills/jobgru"
    echo "Removed router skills and PATH symlink."
    read -r -p "Delete $JOBGRU_HOME? [y/N] " ans
    [[ "$ans" == "y" || "$ans" == "Y" ]] && rm -rf "$JOBGRU_HOME" && echo "Deleted $JOBGRU_HOME"
    ;;
  "")
    exec "$PY" "$SCRIPTS/jobgru_help.py"
    ;;
  *)
    die "Unknown command: $cmd (try: jobgru help)"
    ;;
esac
